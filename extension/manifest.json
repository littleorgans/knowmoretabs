{
  "manifest_version": 3,
  "name": "knowmoretabs",
  "version": "0.2.0",
  "description": "Opens this tab in the Library's Add link, and saves a post you bookmark on X to the Library.",
  "key": "",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1:41878/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["xdom.js", "x.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Add to knowmoretabs",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
