{
  "manifest_version": 3,
  "name": "knowmoretabs: Add link",
  "version": "0.1.0",
  "description": "Opens this tab in the Library's Add link, its address filled in.",
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:41878/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Add to knowmoretabs",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
